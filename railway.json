{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "npm ci --workspaces --include-workspace-root && npm run build -w @paw-order/api"
    },
    "deploy": {
        "startCommand": "npm run typeorm:migrate:deploy -w @paw-order/api && npm run start -w @paw-order/api",
        "healthcheckPath": "/health",
        "restartPolicyType": "ON_FAILURE"
    }
}

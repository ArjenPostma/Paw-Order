# Template only - never put real values here, this file IS committed.
# Copy to .env (gitignored) and fill that in instead.
APP_ENV=development
PORT=4270
CORS_ORIGIN=http://localhost:5173

# Gemini (case text + Nano Banana evidence images)
GEMINI_API_KEY=
# Optional model overrides. Check these still exist before a demo - Google
# retires ids for new keys, and a retired id 404s every generation.
# GEMINI_TEXT_MODEL=gemini-3.7-flash
# The exhibit images are ~90% of the cost of a case, so this pair is the bill:
# roughly $0.101 of images against $0.011 of text. lite is about half the price
# of gemini-3.1-flash-image; swap up if the defendant stops resembling the
# uploaded dog.
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# 1K | 2K | 4K. Each step up is ~1.5x the price per image. Anything else is
# rejected at boot with a warning and falls back to 1K.
# GEMINI_IMAGE_SIZE=1K

# Optional generation ceilings. Concurrency is the one that bounds the bill:
# every slot in flight can be one image call per exhibit at once.
# GENERATION_MAX_CONCURRENT=3
# GENERATION_TIMEOUT_MS=120000
# GENERATION_MAX_PER_MINUTE=1
# GENERATION_MAX_PER_IP_PER_DAY=2
# GENERATION_MAX_PER_DAY=50

# Uploads that do NOT reach generation: a photo with no dog in it, or one whose
# case already exists. Looser than the generation ceilings on purpose, because
# what it bounds is the multipart buffer and the dog check's model call, not a
# case. Picking the wrong photo a few times must not cost a player their minute.
# UPLOAD_MAX_PER_MINUTE=10
# DOG_CHECK_TIMEOUT_MS=8000

# The dog check is a paid model call that runs BEFORE the generation ceilings,
# so it needs its own. Per day it is the only thing standing between an
# anonymous caller and an unbounded bill for uploads that never generate;
# concurrency bounds memory, since each check holds the photo and a base64 copy
# of it (~19MB for an 8MB upload) alive while it runs.
# DOG_CHECK_MAX_PER_DAY=200
# DOG_CHECK_MAX_CONCURRENT=4

# Cloudflare R2 (required in production; unset locally = images become data URLs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Only read by `npm run typeorm:generate` (that script forces APP_ENV=production).
# Prefer a LOCAL prod-shaped Postgres container here. Pointing this at Railway's
# public URL means `npm run typeorm:migrate:deploy` typed at a local prompt runs
# against the live database, out of band with the deploy - and the destructive
# typeorm commands resolve to the same data source.
DATABASE_URL=

# Production only (Railway injects DATABASE_URL and PORT)
# APP_ENV=production
# TRUST_PROXY=true

{
    "name": "@paw-order/api",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "predev": "npm --prefix ../shared run build",
        "dev": "tsx watch src/index.ts",
        "prebuild": "npm --prefix ../shared run build",
        "build": "tsc && tsc-alias --resolve-full-paths",
        "start": "node dist/index.js",
        "pretypecheck": "npm --prefix ../shared run build",
        "typecheck": "tsc --noEmit",
        "pretest": "npm --prefix ../shared run build",
        "test": "vitest run",
        "typeorm:generate": "npm run build && APP_ENV=production typeorm migration:generate ./src/database_bundle/migrations/migration -d ./dist/database_bundle/util/data_source.js --pretty",
        "typeorm:show": "npm run build && APP_ENV=production typeorm migration:show -d ./dist/database_bundle/util/data_source.js",
        "typeorm:migrate:deploy": "APP_ENV=production typeorm migration:run -d ./dist/database_bundle/util/data_source.js"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.700.0",
        "@google/genai": "^1.0.0",
        "@paw-order/shared": "*",
        "better-sqlite3": "^12.11.1",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "joi": "^18.2.3",
        "multer": "^2.0.0",
        "pg": "^8.22.0",
        "reflect-metadata": "^0.2.2",
        "typeorm": "^1.0.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/multer": "^2.0.0",
        "@types/supertest": "^7.2.0",
        "supertest": "^7.2.2",
        "tsc-alias": "^1.9.0",
        "tsx": "^4.23.0",
        "vitest": "^4.1.10"
    }
}
